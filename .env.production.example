# Modèle d'environnement de PRODUCTION.
# Copier vers build/.env sur le VPS et compléter les valeurs.
# NE JAMAIS committer le .env de prod (il contient des secrets).

TZ=UTC
HOST=127.0.0.1
PORT=3333
LOG_LEVEL=info

# Générer sur le VPS depuis build/ : `node ace generate:key`
# (ne pas réutiliser la clé de développement).
APP_KEY=

NODE_ENV=production
SESSION_DRIVER=cookie

# PostgreSQL local — jamais exposé publiquement (ufw ne doit pas ouvrir 5432).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=fixtura
DB_PASSWORD=
DB_DATABASE=fixtura
