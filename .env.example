TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development
SESSION_DRIVER=cookie
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=fixtura
DB_PASSWORD=
DB_DATABASE=fixtura

# Transport Redis pour transmit (fan-out SSE multi-instances). Optionnel :
# laisser vide en dev / instance unique → transmit reste en mémoire.
# À renseigner uniquement pour du scaling multi-instances (PM2 cluster) — cf. §11.
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Suivi des erreurs serveur — Sentry (issue #118). Optionnel : laisser vide
# désactive complètement le suivi (aucune donnée envoyée à un tiers, RGPD §10).
# À renseigner uniquement en prod pour remonter les erreurs serveur (>= 500).
# SENTRY_DSN=
