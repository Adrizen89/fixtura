<!DOCTYPE html>
<html lang="fr">

<head>
  <meta charset="utf-8">

  {{--
    Applique le thème (clair/sombre) AVANT le premier rendu, pour éviter tout
    flash : lit le cookie de préférence `theme` posé par le toggle admin. Sans
    cookie, aucun attribut n'est posé → la préférence système (`prefers-color-scheme`)
    s'applique. Volontairement inline et synchrone, tout en haut du <head>.
  --}}
  <script>
    (function () {
      try {
        var m = document.cookie.match(/(?:^|;\s*)theme=(light|dark)/)
        if (m) document.documentElement.setAttribute('data-theme', m[1])
      } catch (e) {}
    })()
  </script>

  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#16a34a">

  <!-- PWA : manifeste + icône (résilience offline de l'écran public, issue #40). -->
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/icons/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icons/icon.svg">

  <title inertia>Fixtura</title>

  @vite(['inertia/app/app.ts', `inertia/pages/${page.component}.vue`])
  @inertiaHead()
  @stack('dumper')
</head>

<body class="min-h-screen bg-ground font-sans text-sand-12 antialiased">
  @inertia()
</body>

</html>
