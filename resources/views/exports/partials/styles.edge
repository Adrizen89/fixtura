{{--
  Feuille de style commune aux exports imprimables (cf. issue #38).

  Pages Edge **autonomes** (hors app Inertia/Tailwind) : le CSS est donc inline et
  auto-suffisant. Pensé pour une impression **noir & blanc lisible** — la structure
  repose sur des bordures et des graisses (jamais sur la seule couleur de fond), pour
  rester nette même sans impression des arrière-plans. Police Inter self-hostée
  (RGPD §10 — aucun CDN tiers).
--}}
<style>
  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url('/fonts/inter-latin-wght-normal.woff2') format('woff2');
  }

  :root {
    --ink: #111111;
    --muted: #4a4a46;
    --line: #21201c;
    --line-soft: #b9b8b3;
    --zebra: #f3f3f1;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
  }

  body {
    font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica,
      Arial, sans-serif;
    color: var(--ink);
    background: #ffffff;
    line-height: 1.45;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  /* Barre d'actions (à l'écran uniquement) — masquée à l'impression. */
  .toolbar {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.5rem;
    border-bottom: 1px solid var(--line-soft);
    background: #ffffff;
  }

  .toolbar__hint {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .toolbar__actions {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .btn {
    display: inline-block;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.45rem 0.9rem;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
    background: #ffffff;
    cursor: pointer;
  }

  .btn--solid {
    background: var(--ink);
    color: #ffffff;
  }

  .btn--ghost {
    font-weight: 500;
    color: var(--muted);
  }

  .page {
    max-width: 21cm;
    margin: 0 auto;
    padding: 1.5rem 1.75rem 2.5rem;
  }

  .doc-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 2px solid var(--line);
    padding-bottom: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .doc-head h1 {
    font-size: 1.5rem;
    line-height: 1.2;
    margin: 0 0 0.1rem;
  }

  .doc-head .doc-sub {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .doc-head .doc-meta {
    text-align: right;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .doc-title {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
  }

  h2.section-title {
    font-size: 1.05rem;
    margin: 1.5rem 0 0.6rem;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  caption {
    text-align: left;
    font-weight: 700;
    padding-bottom: 0.4rem;
  }

  thead th {
    border-bottom: 2px solid var(--line);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--muted);
    text-align: left;
    padding: 0.4rem 0.5rem;
    white-space: nowrap;
  }

  tbody td,
  tbody th {
    border-bottom: 1px solid var(--line-soft);
    padding: 0.4rem 0.5rem;
    text-align: left;
    font-weight: 400;
  }

  tbody tr:nth-child(even) {
    background: var(--zebra);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .tnum {
    font-variant-numeric: tabular-nums;
  }

  .center {
    text-align: center;
  }

  .strong {
    font-weight: 700;
  }

  .terrain {
    display: inline-block;
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 0.05rem 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .vs {
    color: var(--muted);
    padding: 0 0.4rem;
  }

  .empty {
    border: 1px dashed var(--line-soft);
    border-radius: 8px;
    padding: 2rem 1rem;
    text-align: center;
    color: var(--muted);
  }

  /* --- Feuilles de match --- */
  .sheets {
    display: block;
  }

  .sheet {
    border: 2px solid var(--line);
    border-radius: 8px;
    padding: 1rem 1.15rem 1.1rem;
    margin-bottom: 1rem;
    break-inside: avoid;
    page-break-inside: avoid;
  }

  .sheet__head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 1px solid var(--line-soft);
    padding-bottom: 0.55rem;
    margin-bottom: 0.85rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .sheet__phase {
    font-weight: 700;
    color: var(--ink);
  }

  .sheet__when {
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }

  .sheet__time {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--ink);
  }

  .sheet__teams {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    text-align: center;
  }

  .sheet__team {
    flex: 1 1 0;
    font-size: 1.25rem;
    font-weight: 700;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .sheet__team--home {
    text-align: right;
  }

  .sheet__team--away {
    text-align: left;
  }

  .score-box {
    width: 2.6rem;
    height: 2.6rem;
    border: 2px solid var(--ink);
    border-radius: 6px;
    flex: 0 0 auto;
  }

  .score-sep {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--muted);
  }

  .sheet__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin-top: 0.95rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .sheet__foot span {
    flex: 1 1 12rem;
    border-bottom: 1px solid var(--line-soft);
    padding-bottom: 0.15rem;
  }

  @media print {
    .no-print {
      display: none !important;
    }

    .page {
      max-width: none;
      margin: 0;
      padding: 0;
    }

    tbody tr {
      /* Évite qu'une ligne soit coupée entre deux pages. */
      break-inside: avoid;
    }

    @page {
      size: A4;
      margin: 1.4cm;
    }
  }
</style>
