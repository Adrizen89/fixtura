# @adonisjs/inertia@4 déclare @inertiajs/vue3 en peerOptional épinglé à ^2.3.8
# (ligne « legacy »), alors qu'on reste sur le client @inertiajs/vue3@^3.6.1
# (dist-tag « latest », protocole Inertia compatible). Ce pin optionnel obsolète
# fait échouer `npm ci` (ERESOLVE) sans ce réglage. À retirer quand @adonisjs/inertia
# mettra son peer optionnel à jour vers la 3.x. Cf. épic #76.
legacy-peer-deps=true
